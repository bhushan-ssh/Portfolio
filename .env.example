# Create a Formspree form and paste its public submission URL, then restart/rebuild.
# Never put secret API keys in VITE_* variables: they are included in client JS.
VITE_FORM_ENDPOINT=
# Example: VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
# For GitHub Pages base paths, use the CLI or build-process environment; see README.
